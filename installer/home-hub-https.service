# Serve the Home Hub over HTTPS on :443 with the local cert, so the PWA is fully
# installable (Android/desktop) and service workers run (secure context).
# The existing :80 http service keeps running alongside for plain access.
#
# Install / activate (one-time, sudo):
#   sudo cp installer/home-hub-https.service /etc/systemd/system/
#   sudo systemctl daemon-reload
#   sudo systemctl enable --now home-hub-https.service
#
# Certs are generated by installer/gen-local-cert.sh (private keys stay local,
# out of git). Devices trust the CA once: http://homehub.local/static/homehub-ca.crt
[Unit]
Description=Home LLM Hub (family portal) - HTTPS :443 (homehub.local)
After=qwen-gateway.service ollama.service network-online.target
Wants=qwen-gateway.service

[Service]
Type=simple
User=kanishka
WorkingDirectory=/home/kanishka/kk_works/LLMs/home-hub
EnvironmentFile=/home/kanishka/kk_works/LLMs/home-hub/.env
AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE
ExecStart=/home/kanishka/kk_works/LLMs/home-hub/.venv/bin/uvicorn app.main:app \
  --host 0.0.0.0 --port 443 \
  --ssl-keyfile /home/kanishka/kk_works/LLMs/home-hub/certs/homehub.key \
  --ssl-certfile /home/kanishka/kk_works/LLMs/home-hub/certs/homehub.crt
Restart=on-failure
RestartSec=3

[Install]
WantedBy=multi-user.target
