# Privacy hardening — block third-party phone-home and run the model libraries
# fully offline. Sourced by every service start script; mirrored in
# home-hub/app/config.py so anything the hub launches inherits it too.
#
# This disables EXTERNAL telemetry only. The hub's OWN local usage metrics
# (token/request histograms, per-model resource stats) live in local SQLite and
# are unaffected — local telemetry stays.
#
# To deliberately download a NEW model, run that one command with HF_HUB_OFFLINE=0
# (the hub's model-download path already does this automatically).

export GRADIO_ANALYTICS_ENABLED=False      # Gradio: no analytics, no version check
export HF_HUB_OFFLINE=1                     # huggingface_hub: never hit the network
export TRANSFORMERS_OFFLINE=1              # transformers/diffusers: use cache only
export HF_HUB_DISABLE_TELEMETRY=1          # huggingface_hub: no usage telemetry
export HF_HUB_DISABLE_IMPLICIT_TOKEN=1     # don't attach/lookup a token implicitly
export DO_NOT_TRACK=1                       # generic opt-out honored by several libs
export DISABLE_TELEMETRY=1                  # generic opt-out honored by several libs

# --- Resource guard: leave a couple of the 12 cores free so a generation never
# saturates the whole CPU and makes the box feel frozen. (Memory is the harder
# limit; the hub also serializes image jobs so only one model loads at a time.)
export OMP_NUM_THREADS=10
export OPENBLAS_NUM_THREADS=10
export MKL_NUM_THREADS=10
export NUMEXPR_NUM_THREADS=10
export GGUF_THREADS=10
