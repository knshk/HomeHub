# =============================================================================
# qwen-stack gateway configuration
# -----------------------------------------------------------------------------
# Copy this file to ".env" and adjust the values for your host:
#
#     cp .env.example .env
#
# The gateway loads this file via python-dotenv at startup. The systemd unit
# (deploy/qwen-gateway.service) reads it through EnvironmentFile=.
#
# SECURITY: ".env" contains the ADMIN_TOKEN (admin API for key management).
# Keep it out of version control and chmod 600 it:
#
#     chmod 600 .env
# =============================================================================

# -- Gateway bind address -----------------------------------------------------
# The gateway intentionally binds 0.0.0.0 so LAN clients can reach it. It is
# protected by API keys; the upstream Ollama is NOT and must stay on localhost.
GATEWAY_HOST=0.0.0.0
GATEWAY_PORT=8080

# -- Upstream Ollama (OpenAI-compatible API) ----------------------------------
# Bind Ollama to 127.0.0.1 only (see deploy/ollama-subnet.conf). Never expose
# 11434 to the WAN: Ollama has no authentication of its own.
OLLAMA_BASE_URL=http://127.0.0.1:11434

# -- SQLite database ----------------------------------------------------------
# Stores API key hashes (never plaintext) and the usage log.
DB_PATH=/home/kanishka/kk_works/LLMs/qwen-stack/data/gateway.db

# -- Admin API token ----------------------------------------------------------
# Bearer token for the admin endpoints (create / list / revoke API keys).
# REQUIRED: the admin API is disabled (HTTP 503) until this is set. Generate a
# fresh, unique token before going live with:
#
#     python3 -c "import secrets; print('qwadm-' + secrets.token_hex(20))"
#
ADMIN_TOKEN=REPLACE_ME_WITH_GENERATED_TOKEN

# -- Default per-key rate limit (requests per minute) -------------------------
# Applied to newly created keys unless overridden per key. On exceed -> HTTP 429.
DEFAULT_RPM=60
