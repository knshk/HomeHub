# =============================================================================
# Home LLM Hub (llm.home) configuration
# -----------------------------------------------------------------------------
# Copy this file to ".env" and adjust the values for your host:
#
#     cp .env.example .env
#     chmod 600 .env          # contains secrets (gateway key, admin token)
#
# The hub loads this file via python-dotenv at startup. The systemd unit
# (deploy/home-hub.service) reads it through EnvironmentFile=.
#
# IMPORTANT: This hub is a CLIENT of the existing local gateway at
# /home/kanishka/kk_works/LLMs/qwen-stack. It does NOT modify the gateway.
# Two of the values below (HUB_GATEWAY_KEY, HUB_ADMIN_TOKEN) are MINTED BY /
# COPIED FROM that gateway -- see the notes inline.
# =============================================================================

# -- Hub bind address ---------------------------------------------------------
# The hub binds 0.0.0.0 so LAN family devices can reach it. It is protected by
# device-bound passwordless auth (httponly cookie + admin approval).
# Default rootless port is 8090. The sudo installer (deploy/install-llmhome.sh)
# upgrades the runtime to :80 via setcap so http://llm.home works.
HUB_HOST=0.0.0.0
HUB_PORT=8090

# -- Friendly hub identity (PUBLIC) -------------------------------------------
# HUB_NAME is the human-facing name of this hub. It is advertised over mDNS
# (_homehub._tcp.local.) and returned by the unauthenticated GET /api/discovery
# endpoint so family devices / the login gate can recognise this hub on the LAN.
# It carries NO secrets -- safe to expose. Defaults to "Home Hub" if unset.
HUB_NAME=Home Hub

# PUBLIC_BASE_URL (optional): the origin a browser should open to reach this hub,
# returned as "base_url" by /api/discovery. Defaults to http://<LAN_IP>:<HUB_PORT>.
# Set it when the hub sits behind a name/proxy (e.g. http://homehub.local).
# PUBLIC_BASE_URL=http://homehub.local:8090

# -- Upstream: qwen-stack gateway (LLM chat + key minting) ---------------------
# The hub proxies chat to the gateway's OpenAI-compatible endpoint and mints
# per-user API keys through the gateway admin API. Keep this on localhost; the
# gateway already handles LAN exposure and auth.
GATEWAY_URL=http://127.0.0.1:8080

# HUB_GATEWAY_KEY: a normal gateway API key (qwsk-...) that the HUB ITSELF uses
# to call POST ${GATEWAY_URL}/v1/chat/completions on behalf of users.
#   --> Mint it ONCE from the gateway and paste it here. From the gateway dir:
#         cd /home/kanishka/kk_works/LLMs/qwen-stack
#         make key NAME="home-hub"          # prints qwsk-... exactly once
#       (or: curl -s $GATEWAY_URL/admin/keys -H "Authorization: Bearer <gw admin>" \
#             -H "Content-Type: application/json" -d '{"name":"home-hub"}')
HUB_GATEWAY_KEY=REPLACE_ME_WITH_GATEWAY_API_KEY

# HUB_ADMIN_TOKEN: the gateway's ADMIN_TOKEN. The hub uses it to mint/revoke
# per-user keys via ${GATEWAY_URL}/admin/keys. It ALSO doubles as the hub admin
# claim secret (POST /api/session/claim) that turns a device into an admin.
#   --> Copy the exact ADMIN_TOKEN value from the gateway's .env file:
#         grep ADMIN_TOKEN /home/kanishka/kk_works/LLMs/qwen-stack/.env
HUB_ADMIN_TOKEN=REPLACE_ME_WITH_GATEWAY_ADMIN_TOKEN

# HUB_BOOTSTRAP_TOKEN: an ALTERNATE secret that also satisfies the admin claim
# (POST /api/session/claim). Use it to bootstrap the very first admin device
# without exposing the gateway admin token. Generate a fresh one:
#     python3 -c "import secrets; print('hubboot-' + secrets.token_hex(20))"
# Leave empty to disable the bootstrap path (then only HUB_ADMIN_TOKEN claims).
HUB_BOOTSTRAP_TOKEN=

# HUB_SETUP_CODE: short first-run code (the installer generates a 6-digit one).
# While the hub has NO admin yet, the browser "Welcome" screen accepts this to
# create the first admin — no token typing. Ignored once an admin exists.
# Empty -> first-run is username-only (first-device-wins) on your trusted LAN.
HUB_SETUP_CODE=

# HUB_ADMIN_PIN: optional bootstrap PIN. Any user can become admin from any
# device by entering it (POST /api/session/elevate). An admin can set/change it
# in-app (stored encrypted); this env value is only the fallback. No lockout.
HUB_ADMIN_PIN=

# -- Upstream: Ollama (embeddings + vision captions) --------------------------
# Used at file/photo index time: embed chunk text and caption images. Keep on
# localhost; Ollama has no auth of its own and must never face the WAN.
OLLAMA_URL=http://127.0.0.1:11434

# Embedding model for semantic search over files/photo captions.
#   nomic-embed-text -> 768 dims, Apache-2.0, ~150MB loaded (recommended).
EMBED_MODEL=nomic-embed-text

# Vision model for captioning uploaded photos at index time.
#   moondream -> 1.8GB, Apache-2.0, commercially safe (recommended default).
#   Upgrade to qwen2.5vl:7b for better chart/table/dense-text understanding.
#   DO NOT use LLaVA in a commercial product: its CC BY-NC training data
#   forbids commercial use despite the open weights.
VISION_MODEL=moondream

# -- Upstream: local voice service (STT + TTS) --------------------------------
# A SEPARATE local process the operator runs (NOT part of this hub and NOT part
# of Ollama). It exposes faster-whisper (speech-to-text) + kokoro-onnx (text-to-
# speech) at VOICE_URL. The hub only PROXIES to it (transcribe / speak / health).
# Keep it on localhost; it has no auth of its own and must never face the WAN.
# Contract:
#   GET  /healthz    -> {"status":"ok","stt":...,"tts":...,"voice":...}
#   POST /transcribe -> multipart "audio" (+ optional "language") -> {"text","language"}
#   POST /speak      -> JSON {"text","voice"?,"speed"?} -> audio/wav bytes
VOICE_URL=http://127.0.0.1:8100

# Default TTS voice used when a /api/voice/speak request omits "voice".
# af_sarah is the default English voice shipped with Kokoro-82M (Apache-2.0).
VOICE_DEFAULT_VOICE=af_sarah

# Max size (bytes) of an uploaded audio blob accepted by /api/voice/transcribe.
MAX_VOICE_BYTES=26214400

# -- SQLite database ----------------------------------------------------------
# Stores devices, conversations, notes, checklists, file/chunk index, and the
# per-user key references (key id + prefix only; never plaintext). Device
# tokens and secrets are stored ONLY as sha256 hashes.
DB_PATH=/home/kanishka/kk_works/LLMs/home-hub/data/hub.db

# -- LAN IP (optional hint) ---------------------------------------------------
# Your host's LAN address, used only to print friendly URLs in installers and
# the /api/keys base_url shown to users. If left blank, scripts auto-detect it
# with: ip route get 1.1.1.1. Set it explicitly if auto-detection picks the
# wrong interface (e.g. a docker0 / VPN address).
LAN_IP=
